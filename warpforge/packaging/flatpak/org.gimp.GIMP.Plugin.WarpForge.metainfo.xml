<component type="addon">
  <id>org.gimp.GIMP.Plugin.WarpForge</id>
  <extends>org.gimp.GIMP</extends>
  <name>WarpForge</name>
  <summary>Puppet Warp and Mesh Warp for GIMP</summary>
  <description>
    <p>
      Deform a layer with control pins (Moving Least Squares) or a mesh, with a
      live preview. The warp is applied at full resolution as one undo step,
      keeps the original layer and can be edited again later.
    </p>
  </description>
  <url type="homepage">https://github.com/Gimp3-plugins/Gimp3-plugins/tree/main/warpforge</url>
  <url type="bugtracker">https://github.com/Gimp3-plugins/Gimp3-plugins/issues</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.warpforge">
    <name>WarpForge contributors</name>
  </developer>
  <releases>
    <release version="1.0.0~rc1" date="2026-11-26"/>
  </releases>
</component>
